<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.7.2 ist ab Windows 10 1803 fest eingebaut: keine Installation, keine Laufzeit-Downloads. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>StayGreen</RootNamespace>
    <AssemblyName>StayGreen</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <!-- Statische Analyse des SDK im empfohlenen Umfang. Es bleibt bei Warnungen; der Stand ist derzeit warnungsfrei. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.6.1</Version>
    <FileVersion>1.6.1.0</FileVersion>
    <Product>StayGreen</Product>
    <AssemblyTitle>StayGreen</AssemblyTitle>
    <Company>StayGreen</Company>
    <Authors>StayGreen</Authors>
    <Description>Haelt den Microsoft-Teams-Status auf Verfuegbar (Keeps your Teams status green)</Description>
    <Copyright>MIT License</Copyright>
    <!-- Eine einzige Datei ausliefern: keine .exe.config daneben. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenz-Assemblies, damit sich das Projekt auch unter Linux/macOS bauen laesst. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
